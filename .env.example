# ============================================================
# SMS Backend — Environment Variables
# Reference list of all required env vars. Real .env is tracked on this repo;
# .env.local is gitignored if you need per-machine overrides.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Database ----
# Postgres connection string (use Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sms_db?schema=public

# ---- CORS ----
# Frontend origin(s) allowed to call this API. Comma-separated for multiple.
# Example: CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:3000

# ---- Auth (JWT) ----
# Use a long random string in production (>=32 chars). Generate: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email (SMTP) ----
# Currently uses generic SMTP via nodemailer. Phase 5 will migrate to Resend API.
# For local dev: Mailtrap or Ethereal Email. For Gmail: use an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- ImageKit (file storage) ----
# Get keys from https://imagekit.io/ dashboard
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id

# ---- Paystack (Nigeria payments) ----
# Use test keys (sk_test_...) until live business verification is complete.
PAYSTACK_SECRET_KEY=

# ---- Stripe (international payments) — Phase 3 ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Payment test mode ----
# true  = skip real payment provider, mark purchases as successful (dev only)
# false = real payment flow (always in production)
PAYMENT_TEST_MODE=true

# ---- API base URL (used in webhook callback URLs) ----
API_BASE_URL=http://localhost:3001

# ---- Frontend URL (used to build email links: activation, password reset, etc.) ----
FRONTEND_URL=http://localhost:3000

# ---- Google Maps (used by frontend, mirrored here if needed) ----
GOOGLE_MAPS_API_KEY=

# ============================================================
# Phase 1+ additions (not yet wired — leave blank for now)
# ============================================================

# ---- Sentry (error tracking) — Phase 6 ----
SENTRY_DSN=

# ---- Redis (BullMQ background jobs) — Phase 6 ----
REDIS_URL=

# ---- Termii (SMS for Nigeria) — Phase 5 ----
TERMII_API_KEY=
TERMII_SENDER_ID=
